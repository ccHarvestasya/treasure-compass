{
  "name": "treasure-compass-monorepo",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm run dev:treasure",
    "dev:treasure": "pnpm --filter @treasure-compass/treasure-app dev",
    "dev:mob": "pnpm --filter @treasure-compass/mob-app dev",
    "dev:mob-authoring": "pnpm --filter @treasure-compass/mob-authoring dev",
    "build": "tsc -b && pnpm --filter @treasure-compass/treasure-app exec vite build && pnpm --filter @treasure-compass/mob-app exec vite build && pnpm --filter @treasure-compass/mob-authoring exec vite build",
    "build:treasure": "pnpm --filter @treasure-compass/treasure-app build",
    "build:mob": "pnpm --filter @treasure-compass/mob-app build",
    "build:mob-authoring": "pnpm --filter @treasure-compass/mob-authoring build",
    "typecheck": "tsc -b",
    "lint": "oxlint --type-aware --type-check .",
    "preview": "pnpm run preview:treasure",
    "preview:treasure": "pnpm --filter @treasure-compass/treasure-app preview",
    "preview:mob": "pnpm --filter @treasure-compass/mob-app preview",
    "preview:mob-authoring": "pnpm --filter @treasure-compass/mob-authoring preview",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "oxlint": "^1.82.0",
    "oxlint-tsgolint": "^7.0.2001",
    "@types/node": "^25.9.6",
    "prettier": "^3.9.6",
    "typescript": "~7.0.2",
    "vitest": "^5.0.0"
  }
}
